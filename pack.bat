@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo 正在构建便携版 exe（首次运行会下载依赖，较慢，请耐心等待）...
call npm run dist
if errorlevel 1 (
    echo ========================================
    echo   打包失败！请检查上面的错误信息。
    echo ========================================
    pause
    exit /b 1
)

echo ========================================
echo   打包完成！请到 release\ 目录查看 exe
echo ========================================
pause
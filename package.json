{
  "name": "blight-survivors-2",
  "productName": "Blight Survivors 2",
  "version": "0.5.1",
  "description": "Blight Survivors 2 - 桌面版游戏",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.blight.survivors2",
    "productName": "Blight Survivors 2",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "index.html",
      "css/**",
      "js/**",
      "assets/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blight Survivors 2",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "BlightSurvivors2_Setup_v${version}.exe"
    }
  }
}
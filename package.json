{
  "name": "blight-survivors-2",
  "productName": "Blight Survivors 2",
  "version": "0.3.5",
  "description": "Blight Survivors 2 - 便携版桌面游戏",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.blight.survivors2",
    "productName": "Blight Survivors 2",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "index.html",
      "css/**",
      "js/**",
      "assets/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "BlightSurvivors2_v${version}.exe"
    }
  }
}